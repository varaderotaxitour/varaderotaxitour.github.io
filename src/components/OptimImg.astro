---
interface Props {
  path: string;
  alt: string;
  widths: number[];
  sizes?: string;
  quality?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  style?: string;
}

const {
  path,
  alt,
  widths,
  sizes,
  quality = 75,
  loading = 'lazy',
  fetchpriority,
  class: className,
  style: styleProp,
} = Astro.props;

import { supabaseImageUrl } from '../lib/image';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;

const sorted = [...new Set(widths)].sort((a, b) => a - b);
const largest = sorted[sorted.length - 1];

const srcset =
  sorted.length > 1
    ? sorted.map((w) => `${supabaseImageUrl(supabaseUrl, path, { width: w, quality, format: 'webp' })} ${w}w`).join(', ')
    : undefined;
const src = supabaseImageUrl(supabaseUrl, path, { width: largest, quality, format: 'webp' });
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={largest}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
  style={styleProp}
  draggable="false"
/>
