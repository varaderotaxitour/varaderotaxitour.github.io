---
import { locales, localeHref, pathnameLocale } from '../i18n/ui';

interface Props {
  variant?: 'bar' | 'stack';
}

const { variant = 'bar' } = Astro.props;
const current = Astro.url.pathname;
const currentLocale = pathnameLocale(current);
---

<ul class:list={['lang-switch', `lang-switch--${variant}`]} role="list">
  {
    locales.map((loc) => (
      <li>
        <a
          href={localeHref(current, loc)}
          class={loc === currentLocale ? 'active' : ''}
          aria-current={loc === currentLocale ? 'page' : undefined}
          lang={loc}
        >
          {loc.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid transparent;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .lang-switch a:hover {
    color: var(--teal-deep);
    background: var(--sand-lt);
  }
  .lang-switch a.active {
    color: var(--white);
    background: var(--teal-deep);
  }

  /* Variante apilada dentro del menú móvil */
  .lang-switch--stack {
    margin-block-start: 12px;
    padding-inline: 10px;
    gap: 8px;
  }
  .lang-switch--stack a {
    font-size: 0.85rem;
    padding: 6px 12px;
    border-color: rgba(12, 102, 114, 0.18);
    background: var(--white);
  }
</style>
