---
interface Props {
  name:
    | 'plane'
    | 'wave'
    | 'landmark'
    | 'flag'
    | 'palm'
    | 'dolphin'
    | 'pin'
    | 'glass'
    | 'whatsapp'
    | 'instagram'
    | 'phone'
    | 'check'
    | 'clock'
    | 'car';
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

{name === 'plane' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 13l7-1 4-8 2 1-2.5 7.5L20 11l1 2-6.5 3L13 21l-2-1 1-5-6-2z" />
  </svg>
)}

{name === 'wave' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 16c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2" />
    <path d="M2 10c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2" opacity="0.5" />
    <path d="M12 3l0 4M8 4.5l1.5 3M16 4.5L14.5 7.5" />
  </svg>
)}

{name === 'landmark' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 21h18M4 21V10M20 21V10M2 10l10-6 10 6M6 10v11M10 10v11M14 10v11M18 10v11" />
  </svg>
)}

{name === 'flag' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 3v18" />
    <path d="M5 4c3-1.5 5 1.5 8 0s5 1.5 5 1.5v9c-3 1.5-5-1.5-8 0s-5-1.5-5-1.5z" />
  </svg>
)}

{name === 'palm' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21V11" />
    <path d="M12 11c-2-3-6-4-9-3 1 3 4 4.5 7 4M12 11c2-3 6-4 9-3-1 3-4 4.5-7 4M12 11c-1-3-1-6 1-9 2 2 2 6 0 9M12 11c1.5-2.5 4-3.5 6-3-1 2.5-3 3.8-5 4" />
  </svg>
)}

{name === 'dolphin' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 15c4-6 9-9 15-9-1 2-1 3 0 4-3 0-4 1-4 3 2 0 3 1 3 2-3 1-6 0-7-2-3 1-5 2-7 2z" />
    <path d="M3 15c1 1 3 1.5 5 1" />
  </svg>
)}

{name === 'pin' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21s7-7.2 7-12a7 7 0 10-14 0c0 4.8 7 12 7 12z" />
    <circle cx="12" cy="9" r="2.4" />
  </svg>
)}

{name === 'glass' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 3h12l-1.5 9a4.5 4.5 0 01-9 0z" />
    <path d="M12 15v6M8 21h8" />
  </svg>
)}

{name === 'whatsapp' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
    <path d="M12.02 2c-5.5 0-9.98 4.48-9.98 9.98 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.96 9.96 0 004.82 1.23h.01c5.5 0 9.98-4.48 9.98-9.98S17.52 2 12.02 2zm5.86 14.27c-.25.7-1.45 1.34-2 1.43-.51.08-1.15.11-1.86-.12-.43-.13-.98-.32-1.69-.62-2.97-1.28-4.9-4.27-5.05-4.47-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.05-2.49.27-.3.6-.37.8-.37h.58c.18 0 .43-.07.67.51.25.6.85 2.07.92 2.22.08.15.13.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.48.13.66-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.23.57.35.08.13.08.75-.17 1.44z" />
  </svg>
)}

{name === 'instagram' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
  </svg>
)}

{name === 'phone' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 5c0 8.3 6.7 15 15 15l3-3.6a1 1 0 00-.4-1.6l-4-1.5a1 1 0 00-1.1.3l-1.3 1.6a12 12 0 01-6.4-6.4l1.6-1.3a1 1 0 00.3-1.1L9.2 1.4A1 1 0 007.6 1L4 4a1 1 0 000 1z" />
  </svg>
)}

{name === 'check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 12.5l5 5L20 6" />
  </svg>
)}

{name === 'clock' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3.5 2" />
  </svg>
)}

{name === 'car' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 16l1.2-4.8A2 2 0 016.1 9.6h11.8a2 2 0 011.9 1.6L21 16" />
    <path d="M3 16v2.5a1 1 0 001 1h1.5a1 1 0 001-1V17M21 16v2.5a1 1 0 01-1 1h-1.5a1 1 0 01-1-1V17" />
    <path d="M3 16h18" />
    <circle cx="7.5" cy="17" r="1.6" />
    <circle cx="16.5" cy="17" r="1.6" />
  </svg>
)}
