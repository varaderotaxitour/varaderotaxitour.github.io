---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import OptimImg from './OptimImg.astro';
import Comments from './Comments';
import RouteLightbox from './RouteLightbox';
import { loadSiteData } from '../lib/content';
import { getUi, format, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { content, cars, stops } = await loadSiteData(locale);
const t = getUi(locale);

const whatsappHref = `https://wa.me/${content.whatsappNumber}?text=${encodeURIComponent(
  content.whatsappMessage
)}`;
const instagramHref = content.instagramUrl;
const phoneDisplay = content.phoneDisplay;
const trust = content.trustItems;
---

<Layout
  title={content.seoTitle}
  description={content.seoDescription}
  lang={locale}
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#top" class="brand">
        <img src="/logo.webp" alt="Varadero Taxi Tour" />
      </a>
      <nav class="main-nav" aria-label={t.ariaMainNav}>
        <a href="#rutas">{t.navRoutes}</a>
        <a href="#carros">{t.navCars}</a>
        <a href="#nosotros">{t.navAbout}</a>
        <a href="#contacto">{t.navContact}</a>
      </nav>
      <div class="header-tools">
        <LanguageSwitcher variant="bar" />
        <button
          class="mobile-toggle"
          type="button"
          aria-label={t.ariaOpenMenu}
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-label-open={t.ariaOpenMenu}
          data-label-close={t.ariaCloseMenu}
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label={t.ariaMobileNav}>
      <a href="#rutas">{t.navRoutes}</a>
      <a href="#carros">{t.navCars}</a>
      <a href="#nosotros">{t.navAbout}</a>
      <a href="#contacto">{t.navContact}</a>
      <LanguageSwitcher variant="stack" />
    </nav>
  </header>

  <main id="top">
    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">{content.heroEyebrow}</p>
          <h1>{content.heroTitle}</h1>
          <p class="hero-lead">{content.heroLead}</p>
          <div class="hero-actions">
            <a class="btn btn-ghost" href="#rutas">{t.heroCta}</a>
          </div>
          <p class="hero-note">{content.heroNote}</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-badge">
            {content.heroImageUrl ? (
              <OptimImg
                class="hero-photo"
                path={content.heroImageUrl}
                alt=""
                widths={[600, 900, 1200]}
                sizes="(max-width: 860px) 70vw, 360px"
                loading="eager"
                fetchpriority="high"
                quality={78}
              />
            ) : (
              <img src="/logo.webp" alt="" />
            )}
          </div>
        </div>
      </div>

      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,32 C240,90 480,0 720,28 C960,56 1200,84 1440,40 L1440,90 L0,90 Z" fill="var(--cream)" />
      </svg>
    </section>

    <!-- ===================== NOSOTROS / TRUST ===================== -->
    <section id="nosotros" class="section about">
      <div class="container about-inner">
        <blockquote class="about-quote reveal">
          "{content.aboutQuote}"
        </blockquote>
        <p class="about-text reveal">{content.aboutText}</p>

        {content.aboutImageUrl && (
          <OptimImg
            class="about-photo reveal"
            path={content.aboutImageUrl}
            alt="Varadero Taxi Tour"
            widths={[800, 1200]}
            sizes="(max-width: 700px) 100vw, 640px"
          />
        )}

        <ul class="trust-grid">
          {trust.map((item) => (
            <li class="trust-card reveal">
              <span class="trust-icon"><Icon name={item.icon as any} size={26} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== RUTAS / SERVICIOS ===================== -->
    <section id="rutas" class="section routes">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.routesEyebrow}</p>
          <h2>{t.routesTitle}</h2>
          <p>{t.routesIntro}</p>
        </div>

        <div class="routes-grid">
          {stops.map((stop) => (
            <article class="route-card reveal">
              {stop.photos.length > 0 ? (
                <button
                  class="route-photo-main"
                  type="button"
                  data-route-index={stops.indexOf(stop)}
                  data-photo-index={0}
                  aria-label={
                    stop.photos.length === 1
                      ? format(t.ariaViewPhotosOne, { title: stop.title })
                      : format(t.ariaViewPhotosMany, { count: stop.photos.length, title: stop.title })
                  }
                >
                  <OptimImg
                    path={stop.photos[0]}
                    alt={stop.title}
                    widths={[400, 800]}
                    sizes="(max-width: 860px) 100vw, 50vw"
                  />
                  <span class="photo-count">{stop.photos.length}</span>
                </button>
              ) : (
                <div class="route-photo-placeholder" aria-hidden="true">
                  <Icon name={stop.icon as any} size={40} />
                </div>
              )}
              <div class="route-body">
                <div class="route-card-head">
                  <h3>
                    <span class="route-icon" aria-hidden="true"><Icon name={stop.icon as any} size={16} /></span>
                    {stop.title}
                  </h3>
                  <span class="price-pill">{stop.price} <small>USD/EUR</small></span>
                </div>
                <p>{stop.desc}</p>
                {stop.photos.length > 1 && (
                  <div class="route-thumbs">
                    {stop.photos.slice(1).map((photo, thumbIdx) => (
                      <button
                        class="route-thumb"
                        type="button"
                        data-route-index={stops.indexOf(stop)}
                        data-photo-index={thumbIdx + 1}
                        aria-label={format(t.ariaOpenPhoto, { index: thumbIdx + 2, title: stop.title })}
                      >
                        <OptimImg path={photo} alt="" widths={[200]} quality={70} />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
        <script
          type="application/json"
          id="routes-lightbox-data"
          set:html={JSON.stringify(stops.map((stop) => ({ title: stop.title, photos: stop.photos })))}
        />
      </div>
    </section>

    <!-- ===================== CARROS DISPONIBLES ===================== -->
    {cars.length > 0 && (
      <section id="carros" class="section cars">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">{t.carsEyebrow}</p>
            <h2>{t.carsTitle}</h2>
            <p>{t.carsIntro}</p>
          </div>

          <div class="cars-grid">
            {cars.map((car) => (
              <article class="car-card reveal">
                <div class="car-photos">
                  {car.photos && car.photos.length > 0 ? (
                    <>
                      <OptimImg
                        class="car-photo-main"
                        path={car.photos[0]}
                        alt={car.name}
                        widths={[400, 800]}
                        sizes="(max-width: 560px) 100vw, 340px"
                      />
                      {car.photos.length > 1 && (
                        <div class="car-thumbs">
                          {car.photos.slice(1, 5).map((photo) => (
                            <OptimImg path={photo} alt="" widths={[200]} />
                          ))}
                        </div>
                      )}
                    </>
                  ) : (
                    <div class="car-photo-placeholder">
                      <Icon name="car" size={48} />
                    </div>
                  )}
                </div>
                <div class="car-body">
                  <h3>{car.name}</h3>
                  {car.details && <p class="car-details">{car.details}</p>}
                  <p class="car-desc">{car.description}</p>
                  <a
                    class="btn btn-primary car-cta"
                    href={`https://wa.me/${content.whatsappNumber}?text=${encodeURIComponent(format(t.carWaMessage, { name: car.name }))}`}
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="whatsapp" size={18} /> {t.carBookBtn}
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===================== CTA FINAL ===================== -->
    <section id="contacto" class="section cta-final">
      <div class="container cta-inner">
        <p class="eyebrow">{content.ctaEyebrow}</p>
        <h2>{content.ctaTitle}</h2>
        <p class="cta-lead">{content.ctaLead}</p>

        <div class="cta-actions">
          <a class="btn btn-outline-light" href={`tel:+${content.whatsappNumber}`}>
            <Icon name="phone" size={18} /> {phoneDisplay}
          </a>
          <a class="btn btn-outline-light" href={instagramHref} target="_blank" rel="noopener">
            <Icon name="instagram" size={18} /> Instagram
          </a>
        </div>
      </div>
    </section>

    <!-- ===================== COMENTARIOS ===================== -->
    <section id="comentarios" class="section comments">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.commentsEyebrow}</p>
          <h2>{t.commentsTitle}</h2>
        </div>
        <Comments client:load locale={locale} strings={{ ...t }} />
      </div>
    </section>
  </main>

  <RouteLightbox client:load strings={{
    lbPhotosOfTitle: t.lbPhotosOfTitle,
    lbGallery: t.lbGallery,
    lbClose: t.lbClose,
    lbPrevPhoto: t.lbPrevPhoto,
    lbNextPhoto: t.lbNextPhoto,
  }} />

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="/logo.webp" alt="Varadero Taxi Tour" />
        <p>{content.footerTagline}</p>
      </div>
      <p class="footer-note">© {new Date().getFullYear()} {content.footerCopyright}</p>
    </div>
  </footer>

  <a class="whatsapp-float" href={whatsappHref} target="_blank" rel="noopener" aria-label={t.whatsappFloatAria}>
    <Icon name="whatsapp" size={30} />
  </a>
</Layout>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const mobileNav = document.querySelector('#mobile-nav');

  function closeMenu() {
    toggle?.classList.remove('is-open');
    mobileNav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute(
      'aria-label',
      (toggle as HTMLElement | null)?.dataset.labelOpen ?? 'Abrir menú'
    );
  }

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open');
    toggle.classList.toggle('is-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    const labels = (toggle as HTMLElement).dataset;
    toggle.setAttribute('aria-label', isOpen ? labels.labelClose ?? '' : labels.labelOpen ?? '');
  });

  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  // ---- Lightbox de rutas ----
  const routesDataEl = document.getElementById('routes-lightbox-data');
  if (routesDataEl) {
    let routesLightbox: { title: string; photos: string[] }[] = [];
    try {
      routesLightbox = JSON.parse(routesDataEl.textContent || '[]');
    } catch {
      routesLightbox = [];
    }
    document.querySelectorAll<HTMLElement>('[data-route-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const route = routesLightbox[Number(btn.dataset.routeIndex)];
        if (!route || !route.photos?.length) return;
        window.dispatchEvent(
          new CustomEvent('route-lightbox:open', {
            detail: {
              photos: route.photos,
              title: route.title,
              index: Number(btn.dataset.photoIndex) || 0,
            },
          })
        );
      });
    });
  }
</script>

<style>
  /* ===================== HEADER ===================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(251, 247, 238, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(12, 102, 114, 0.12);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
  }
  .brand img { height: 52px; width: auto; }
  .main-nav {
    display: flex;
    gap: 28px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .main-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .main-nav a:hover { color: var(--teal-deep); }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  @media (max-width: 760px) {
    .main-nav { display: none; }
    .brand img { height: 44px; }
  }

  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    background: linear-gradient(155deg, var(--teal-deep) 0%, var(--teal) 48%, var(--turquoise) 100%);
    overflow: hidden;
    padding-top: clamp(48px, 7vw, 88px);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 40px;
    padding-bottom: clamp(72px, 10vw, 120px);
    position: relative;
    z-index: 1;
  }
  .hero-copy .eyebrow { color: var(--sand); }
  .hero-copy h1 {
    color: var(--white);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    margin-top: 10px;
    max-width: 15ch;
  }
  .hero-lead {
    color: rgba(255, 255, 255, 0.92);
    margin-top: 20px;
    font-size: 1.08rem;
    max-width: 50ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .hero-note {
    margin-top: 18px;
    color: var(--sand);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .hero-badge {
    width: min(360px, 86vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgba(255,255,255,0.35), rgba(255,255,255,0) 60%),
      rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    box-shadow: 0 30px 60px -20px rgba(6, 40, 45, 0.55);
  }
  .hero-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(6, 40, 45, 0.35));
  }
  .hero-badge .hero-photo {
    object-fit: cover;
    border-radius: 50%;
    filter: none;
  }

  .hero-wave {
    display: block;
    width: 100%;
    height: 60px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy h1 { max-width: none; margin-inline: auto; }
    .hero-lead { margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .hero-visual { order: -1; }
    .hero-badge { width: min(260px, 70vw); }
  }

  /* ===================== NOSOTROS ===================== */
  .about-inner { max-width: 880px; margin-inline: auto; text-align: center; }
  .about-quote {
    font-family: var(--font-display);
    color: var(--teal-deep);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    max-width: 26ch;
    margin-inline: auto;
  }
  .about-text {
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 62ch;
    margin-inline: auto;
  }
  .about-photo {
    margin: 34px auto 0;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: min(100%, 640px);
  }

  .trust-grid {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    text-align: left;
  }
  .trust-card {
    background: var(--white);
    border-radius: var(--radius-md);
    padding: 26px 24px;
    box-shadow: var(--shadow-soft);
  }
  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--sand-lt);
    color: var(--gold-dark);
    margin-bottom: 14px;
  }
  .trust-card h3 { font-size: 1.1rem; color: var(--teal-deep); }
  .trust-card p { margin-top: 8px; color: var(--ink-soft); font-size: 0.95rem; }

  @media (max-width: 760px) {
    .trust-grid { grid-template-columns: 1fr; }
  }

  /* ===================== RUTAS (grid 2 columnas) ===================== */
  .routes { background: var(--sand-lt); }

  .routes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }

  .route-card {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .route-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .route-photo-main {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: var(--sand-lt);
    cursor: zoom-in;
  }
  .route-photo-main img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }
  .route-photo-main:hover img { transform: scale(1.04); }
  .photo-count {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(6, 40, 45, 0.72);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .photo-count::before { content: '📷 '; font-size: 0.7rem; }

  .route-photo-placeholder {
    height: 110px;
    display: grid;
    place-items: center;
    color: var(--teal);
    background: linear-gradient(160deg, var(--turquoise-lt), var(--sand-lt));
  }

  .route-body {
    padding: 14px 16px 16px;
    display: grid;
    gap: 8px;
    flex: 1;
    align-content: start;
  }
  .route-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }
  .route-card-head h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    color: var(--teal-deep);
    line-height: 1.25;
  }
  .route-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--turquoise-lt);
    color: var(--teal-deep);
  }
  .route-body p {
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .route-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .route-thumb {
    padding: 0;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--sand-lt);
  }
  .route-thumb img {
    width: 56px;
    height: 44px;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .route-thumb:hover img { transform: scale(1.08); opacity: 0.85; }

  .price-pill {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--teal-deep);
    background: var(--turquoise-lt);
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .price-pill small { font-weight: 500; opacity: 0.75; font-size: 0.72em; }

  @media (max-width: 860px) {
    .routes-grid { grid-template-columns: 1fr; }
  }

  /* ===================== CARROS ===================== */
  .cars { background: var(--cream); }
  .cars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
  }
  .car-card {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .car-photos {
    position: relative;
    background: var(--sand-lt);
  }
  .car-photo-main {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  .car-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 4px;
    background: var(--white);
  }
  .car-thumbs img {
    width: 100%;
    height: 64px;
    object-fit: cover;
    border-radius: 6px;
  }
  .car-photo-placeholder {
    height: 220px;
    display: grid;
    place-items: center;
    color: var(--teal);
    background: var(--sand-lt);
  }
  .car-body {
    padding: 22px 22px 24px;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .car-body h3 {
    font-size: 1.22rem;
    color: var(--teal-deep);
    line-height: 1.15;
  }
  .car-details {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--gold-dark);
    letter-spacing: 0.02em;
  }
  .car-desc {
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.55;
  }
  .car-cta {
    margin-top: 8px;
    justify-content: center;
    width: fit-content;
    padding: 10px 20px;
    font-size: 0.92rem;
  }
  @media (max-width: 560px) {
    .cars-grid { grid-template-columns: 1fr; }
    .car-photo-main { height: 200px; }
  }

  /* ===================== CTA FINAL ===================== */
