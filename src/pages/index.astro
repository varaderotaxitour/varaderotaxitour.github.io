---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Comments from '../components/Comments';
import { createClient } from '@supabase/supabase-js';

const fallback = {
  seoTitle: 'Varadero Taxi Tour — Taxi privado, traslados y excursiones en Varadero',
  seoDescription:
    'Servicio de taxi privado en Varadero, Cuba. Traslados desde el aeropuerto, excursiones a La Habana y paseos personalizados por la península en convertibles de época.',
  whatsappNumber: '5356202733',
  whatsappMessage:
    'Hola! Quisiera reservar un traslado o excursión con Varadero Taxi Tour.',
  phoneDisplay: '+53 5 620 2733',
  instagramUrl:
    'https://www.instagram.com/michael.taxipremium?igsh=MWVvbzh3Nm0xMHRjYw==',
  heroEyebrow: 'Taxi privado · Varadero, Cuba',
  heroTitle: 'Tu aventura cubana empieza en un convertible de época.',
  heroLead:
    'Traslados cómodos y seguros desde el aeropuerto, viajes a La Habana y las mejores excursiones personalizadas por la península y sus alrededores. No solo te llevamos a tu destino: te mostramos los secretos de la isla.',
  heroNote: 'Servicio 100% personalizado · Respuesta rápida por WhatsApp',
  aboutQuote:
    'No solo te llevamos a tu destino, te mostramos los secretos de la isla.',
  aboutText:
    '¿Necesitas un taxi para una excursión a La Habana? ¿Un traslado desde el aeropuerto? ¿O quizás un paseo por los rincones más mágicos de la península? Nosotros nos encargamos de todo, para que disfrutes de un servicio pensado a tu medida.',
  trustItems: [
    { icon: 'clock', title: 'Puntualidad', text: 'Reserva con antelación y olvídate de esperar.' },
    { icon: 'car', title: 'Autos impecables', text: 'Vive la experiencia al aire libre en nuestros convertibles de época.' },
    { icon: 'check', title: 'Tarifas claras', text: 'Precios justos, sin sorpresas ni recargos ocultos.' },
  ],
  routes: [
    {
      icon: 'plane',
      title: 'Traslado Aeropuerto Varadero',
      description: 'Te recogemos o te llevamos al aeropuerto con puntualidad garantizada, sin esperas ni sorpresas.',
      priceFrom: 65,
      priceTo: 85,
    },
    {
      icon: 'wave',
      title: 'Cuevas de Saturno + Snorkel o Buceo',
      description: 'Un chapuzón en el cenote de Cuevas de Saturno y snorkel o buceo en las aguas de Playa Coral.',
      priceFrom: 65,
      priceTo: 85,
    },
    {
      icon: 'landmark',
      title: 'Excursión a Matanzas',
      description: 'Cuevas de Bellamar, centro histórico, Bulevar, Museo Farmacéutico, Teatro Sauto, Museo de Bomberos y Parque Libertad.',
      priceFrom: 85,
      priceTo: 105,
    },
    {
      icon: 'flag',
      title: 'Excursión a La Habana',
      description: 'Plaza de la Revolución, paseo por el Malecón, recorrido por La Habana Vieja, Fábrica de Tabacos y visita al Morro-Cabaña.',
      priceFrom: 125,
      priceTo: 155,
    },
    {
      icon: 'palm',
      title: 'Excursión por Varadero',
      description: 'Casa Dupont y campo de golf, Peñón del Fraile, Bulevar, Bar Beatles, Parque Josoné, Bar Floridita, cervecería, mirador de calle 30 y feria de artesanía.',
      priceFrom: 35,
      priceTo: 55,
    },
    {
      icon: 'dolphin',
      title: 'Delfinario',
      description: 'Visita con espera incluida: show de delfines, fotografías y paseo en camellos.',
      priceFrom: 15,
      priceTo: 25,
    },
    {
      icon: 'pin',
      title: 'Bulevar de la Marina',
      description: 'Recorrido y estancia de 1 a 3 horas: bolos, billar, tiendas y restaurantes.',
      priceFrom: 25,
      priceTo: 35,
    },
    {
      icon: 'glass',
      title: 'Bares y restaurantes',
      description: 'Te sugerimos los mejores lugares, con estancia de 2 a 3 horas y espera incluida.',
      priceFrom: 15,
      priceTo: 25,
    },
  ],
  ctaEyebrow: 'Listo para una experiencia única',
  ctaTitle: 'Contacta, reserva y relájate: tu aventura cubana empieza aquí.',
  ctaLead:
    'Haz tu reserva ahora y asegura tus traslados y paseos en Varadero con el mejor precio y la máxima comodidad.',
  footerTagline: 'Taxi privado y excursiones en Varadero, Cuba.',
  footerCopyright: 'Varadero Taxi Tour. Hecho con cariño en la península.',
};

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
const supabaseStorage = supabaseUrl
  ? `${supabaseUrl}/storage/v1/object/public/fotos`
  : '';

function rowToContent(row: any) {
  return {
    seoTitle: row.seo_title,
    seoDescription: row.seo_description,
    whatsappNumber: row.whatsapp_number,
    whatsappMessage: row.whatsapp_message,
    phoneDisplay: row.phone_display,
    instagramUrl: row.instagram_url,
    heroEyebrow: row.hero_eyebrow,
    heroTitle: row.hero_title,
    heroLead: row.hero_lead,
    heroNote: row.hero_note,
    heroImageUrl: row.hero_image_url,
    aboutQuote: row.about_quote,
    aboutText: row.about_text,
    aboutImageUrl: row.about_image_url,
    trustItems: row.trust_items,
    routes: row.routes,
    ctaEyebrow: row.cta_eyebrow,
    ctaTitle: row.cta_title,
    ctaLead: row.cta_lead,
    footerTagline: row.footer_tagline,
    footerCopyright: row.footer_copyright,
  };
}

type Car = {
  id: number;
  name: string;
  description: string;
  details: string | null;
  photos: string[];
  is_active: boolean;
  sort_order: number;
};

let content = fallback;
let cars: Car[] = [];
try {
  if (supabaseUrl && supabaseKey) {
    const supabase = createClient(supabaseUrl, supabaseKey, {
      auth: { persistSession: false },
    });
    const { data } = await supabase
      .from('settings')
      .select('*')
      .limit(1)
      .maybeSingle();
    if (data) content = { ...fallback, ...rowToContent(data) };

    const { data: carsData, error: carsError } = await supabase
      .from('cars')
      .select('id, name, description, details, photos, is_active, sort_order')
      .eq('is_active', true)
      .order('sort_order', { ascending: true })
      .order('created_at', { ascending: false });
    if (!carsError && carsData) cars = carsData as Car[];
    if (carsError) console.warn('[supabase] No se pudieron cargar los carros:', carsError.message);
  } else {
    console.warn(
      '[supabase] Faltan PUBLIC_SUPABASE_URL o PUBLIC_SUPABASE_ANON_KEY, usando valores locales.'
    );
  }
} catch (error) {
  console.warn(
    '[supabase] No se pudo cargar el contenido, usando valores locales:',
    error
  );
}

const whatsappHref = `https://wa.me/${content.whatsappNumber}?text=${encodeURIComponent(
  content.whatsappMessage
)}`;
const instagramHref = content.instagramUrl;
const phoneDisplay = content.phoneDisplay;

const stops = content.routes.map((route) => ({
  icon: route.icon,
  title: route.title,
  desc: route.description,
  price: `${route.priceFrom} – ${route.priceTo}`,
}));

const trust = content.trustItems;
---

<Layout
  title={content.seoTitle}
  description={content.seoDescription}
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#top" class="brand">
        <img src="/logo.webp" alt="Varadero Taxi Tour" />
      </a>
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="#rutas">Rutas &amp; precios</a>
        <a href="#carros">Carros</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <button class="mobile-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil">
      <a href="#rutas">Rutas &amp; precios</a>
      <a href="#carros">Carros</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <main id="top">
    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">{content.heroEyebrow}</p>
          <h1>{content.heroTitle}</h1>
          <p class="hero-lead">{content.heroLead}</p>
          <div class="hero-actions">
            <a class="btn btn-ghost" href="#rutas">Ver rutas y precios</a>
          </div>
          <p class="hero-note">{content.heroNote}</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-badge">
            {content.heroImageUrl ? (
              <img class="hero-photo" src={`${supabaseStorage}/${content.heroImageUrl}?width=900`} alt="" />
            ) : (
              <img src="/logo.webp" alt="" />
            )}
          </div>
        </div>
      </div>

      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,32 C240,90 480,0 720,28 C960,56 1200,84 1440,40 L1440,90 L0,90 Z" fill="var(--cream)" />
      </svg>
    </section>

    <!-- ===================== NOSOTROS / TRUST ===================== -->
    <section id="nosotros" class="section about">
      <div class="container about-inner">
        <blockquote class="about-quote reveal">
          "{content.aboutQuote}"
        </blockquote>
        <p class="about-text reveal">{content.aboutText}</p>

        {content.aboutImageUrl && (
          <img class="about-photo reveal" src={`${supabaseStorage}/${content.aboutImageUrl}?width=1200`} alt="Varadero Taxi Tour" />
        )}

        <ul class="trust-grid">
          {trust.map((item) => (
            <li class="trust-card reveal">
              <span class="trust-icon"><Icon name={item.icon as any} size={26} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== RUTAS / SERVICIOS ===================== -->
    <section id="rutas" class="section routes">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Nuestra ruta por Varadero</p>
          <h2>Cada parada, una experiencia distinta</h2>
          <p>
            Los precios varían según tu zona de hospedaje: el primer número es la tarifa más
            cercana a Varadero centro y el segundo, la más alejada. Todo en USD o EUR.
          </p>
        </div>

        <ol class="route-list">
          {stops.map((stop) => (
            <li class="route-stop reveal">
              <div class="route-marker" aria-hidden="true">
                <Icon name={stop.icon as any} size={22} />
              </div>
              <div class="route-card">
                <div class="route-card-head">
                  <h3>{stop.title}</h3>
                  <span class="price-pill">{stop.price} <small>USD/EUR</small></span>
                </div>
                <p>{stop.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===================== CARROS DISPONIBLES ===================== -->
    {cars.length > 0 && (
      <section id="carros" class="section cars">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Nuestra flota</p>
            <h2>Carros disponibles</h2>
            <p>
              Elige tu favorito y vive Varadero a tu ritmo. Todos con chofer privado,
              aire acondicionado y el encanto de un clásico bien cuidado.
            </p>
          </div>

          <div class="cars-grid">
            {cars.map((car) => (
              <article class="car-card reveal">
                <div class="car-photos">
                  {car.photos && car.photos.length > 0 ? (
                    <>
                      <img
                        class="car-photo-main"
                        src={`${supabaseStorage}/${car.photos[0]}?width=800`}
                        alt={car.name}
                        loading="lazy"
                      />
                      {car.photos.length > 1 && (
                        <div class="car-thumbs">
                          {car.photos.slice(1, 5).map((photo) => (
                            <img
                              src={`${supabaseStorage}/${photo}?width=400`}
                              alt=""
                              loading="lazy"
                            />
                          ))}
                        </div>
                      )}
                    </>
                  ) : (
                    <div class="car-photo-placeholder">
                      <Icon name="car" size={48} />
                    </div>
                  )}
                </div>
                <div class="car-body">
                  <h3>{car.name}</h3>
                  {car.details && <p class="car-details">{car.details}</p>}
                  <p class="car-desc">{car.description}</p>
                  <a
                    class="btn btn-primary car-cta"
                    href={`https://wa.me/${content.whatsappNumber}?text=${encodeURIComponent(`Hola! Me interesa reservar el carro "${car.name}" con Varadero Taxi Tour.`)}`}
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="whatsapp" size={18} /> Reservar este carro
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===================== CTA FINAL ===================== -->
    <section id="contacto" class="section cta-final">
      <div class="container cta-inner">
        <p class="eyebrow">{content.ctaEyebrow}</p>
        <h2>{content.ctaTitle}</h2>
        <p class="cta-lead">{content.ctaLead}</p>

        <div class="cta-actions">
          <a class="btn btn-outline-light" href={`tel:+${content.whatsappNumber}`}>
            <Icon name="phone" size={18} /> {phoneDisplay}
          </a>
          <a class="btn btn-outline-light" href={instagramHref} target="_blank" rel="noopener">
            <Icon name="instagram" size={18} /> Instagram
          </a>
        </div>
      </div>
    </section>

    <!-- ===================== COMENTARIOS ===================== -->
    <section id="comentarios" class="section comments">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Comentarios</p>
          <h2>Lo que dicen nuestros pasajeros</h2>
        </div>
        <Comments client:load />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="/logo.webp" alt="Varadero Taxi Tour" />
        <p>{content.footerTagline}</p>
      </div>
      <p class="footer-note">© {new Date().getFullYear()} {content.footerCopyright}</p>
    </div>
  </footer>

  <a class="whatsapp-float" href={whatsappHref} target="_blank" rel="noopener" aria-label="Reservar por WhatsApp">
    <Icon name="whatsapp" size={30} />
  </a>
</Layout>

<style>
  /* ===================== HEADER ===================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(251, 247, 238, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(12, 102, 114, 0.12);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
  }
  .brand img { height: 52px; width: auto; }
  .main-nav {
    display: flex;
    gap: 28px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .main-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .main-nav a:hover { color: var(--teal-deep); }

  @media (max-width: 760px) {
    .main-nav { display: none; }
    .brand img { height: 44px; }
  }

  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    background: linear-gradient(155deg, var(--teal-deep) 0%, var(--teal) 48%, var(--turquoise) 100%);
    overflow: hidden;
    padding-top: clamp(48px, 7vw, 88px);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 40px;
    padding-bottom: clamp(72px, 10vw, 120px);
    position: relative;
    z-index: 1;
  }
  .hero-copy .eyebrow { color: var(--sand); }
  .hero-copy h1 {
    color: var(--white);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    margin-top: 10px;
    max-width: 15ch;
  }
  .hero-lead {
    color: rgba(255, 255, 255, 0.92);
    margin-top: 20px;
    font-size: 1.08rem;
    max-width: 50ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .hero-note {
    margin-top: 18px;
    color: var(--sand);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .hero-badge {
    width: min(360px, 86vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgba(255,255,255,0.35), rgba(255,255,255,0) 60%),
      rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    box-shadow: 0 30px 60px -20px rgba(6, 40, 45, 0.55);
  }
  .hero-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(6, 40, 45, 0.35));
  }
  .hero-badge .hero-photo {
    object-fit: cover;
    border-radius: 50%;
    filter: none;
  }

  .hero-wave {
    display: block;
    width: 100%;
    height: 60px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy h1 { max-width: none; margin-inline: auto; }
    .hero-lead { margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .hero-visual { order: -1; }
    .hero-badge { width: min(260px, 70vw); }
  }

  /* ===================== NOSOTROS ===================== */
  .about-inner { max-width: 880px; margin-inline: auto; text-align: center; }
  .about-quote {
    font-family: var(--font-display);
    color: var(--teal-deep);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    max-width: 26ch;
    margin-inline: auto;
  }
  .about-text {
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 62ch;
    margin-inline: auto;
  }
  .about-photo {
    margin: 34px auto 0;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .trust-grid {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    text-align: left;
  }
  .trust-card {
    background: var(--white);
    border-radius: var(--radius-md);
    padding: 26px 24px;
    box-shadow: var(--shadow-soft);
  }
  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--sand-lt);
    color: var(--gold-dark);
    margin-bottom: 14px;
  }
  .trust-card h3 { font-size: 1.1rem; color: var(--teal-deep); }
  .trust-card p { margin-top: 8px; color: var(--ink-soft); font-size: 0.95rem; }

  @media (max-width: 760px) {
    .trust-grid { grid-template-columns: 1fr; }
  }

  /* ===================== RUTAS (signature timeline) ===================== */
  .routes { background: var(--sand-lt); }

  .route-list {
    position: relative;
    display: grid;
    gap: 26px;
    counter-reset: stop;
  }
  .route-list::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 8px;
    bottom: 8px;
    width: 0;
    border-left: 3px dashed var(--turquoise);
  }

  .route-stop {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    counter-increment: stop;
  }
  .route-marker {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--teal-deep);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 6px var(--sand-lt);
  }
  .route-card {
    background: var(--white);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    box-shadow: var(--shadow-soft);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .route-stop:hover .route-card {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .route-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
  }
  .route-card-head h3 {
    font-size: 1.12rem;
    color: var(--teal-deep);
  }
  .route-card p {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .price-pill {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--teal-deep);
    background: var(--turquoise-lt);
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .price-pill small { font-weight: 500; opacity: 0.75; font-size: 0.72em; }

  @media (max-width: 560px) {
    .route-marker { width: 36px; height: 36px; }
    .route-list::before { left: 17px; }
    .route-stop { grid-template-columns: 36px 1fr; gap: 12px; }
    .route-card { padding: 18px; }
  }

  /* ===================== CARROS ===================== */
  .cars { background: var(--cream); }
  .cars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
  }
  .car-card {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .car-photos {
    position: relative;
    background: var(--sand-lt);
  }
  .car-photo-main {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  .car-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 4px;
    background: var(--white);
  }
  .car-thumbs img {
    width: 100%;
    height: 64px;
    object-fit: cover;
