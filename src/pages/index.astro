  }
  .car-photo-placeholder {
    height: 220px;
    display: grid;
    place-items: center;
    color: var(--teal);
    background: var(--sand-lt);
  }
  .car-body {
    padding: 22px 22px 24px;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .car-body h3 {
    font-size: 1.22rem;
    color: var(--teal-deep);
    line-height: 1.15;
  }
  .car-details {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--gold-dark);
    letter-spacing: 0.02em;
  }
  .car-desc {
